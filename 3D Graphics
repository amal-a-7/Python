rectangle.py

import math
def rect_area(l,b):
    return l*b
def rect_perimeter(l,b):
    return 2*(l+b)

circle.py

import math
def circle_area(r):
    return pi*r*r
def circle_perimeter(r):
    return pi*r*2

sphere.py(D-graph)


import math
def sphere_area(r):
    return 4*pi*r*r
def sphere_perimeter(r):
    return 2*pi*r

cuboid.py

import math(D-graph)
def cuboid_area(l,b,h):
    return 2*(l*b+b*h+l*h)
def cuboid_perimeter(l,b,h):
    return 4*(l+b+h)

